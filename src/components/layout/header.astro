        ) : (
          <div class={`grid ${getGridCols(item.dropdownClass)} gap-2`}>
            {item.links?.map(link => (
              link.featured ? (
                <a href={link.href} rel="noopener noreferrer" class="openhouse-featured-link group block p-4 rounded-xl relative overflow-hidden" style="background: linear-gradient(135deg, #1a237e 0%, #1565c0 50%, #0288d1 100%);">
                  <span class="openhouse-shimmer"></span>
                  <span class="badge-nuevo">¡Evento!</span>
                  <h3 class="font-bold text-white mb-1 relative z-10">{link.title}</h3>
                  <p class="text-sm text-blue-100 relative z-10">{link.desc}</p>
                </a>
              ) : (
                <a href={link.href} rel="noopener noreferrer" class="group block p-4 rounded-lg hover:bg-blue-50 transition-colors duration-200">
                  <h3 class="font-bold text-gray-900 group-hover:text-azul-une mb-1">{link.title}</h3>
                  <p class="text-sm text-gray-600">{link.desc}</p>
                </a>
              )
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</header>

<!-- 🚀 OPTIMIZACIÓN 4: Mobile Menu con lazy loading de imágenes -->
<div class="md:hidden mobile-menu fixed inset-0 z-50 opacity-0 invisible transition-opacity duration-300 bg-black/50">
  <div class="mobile-menu-container absolute top-0 left-0 h-full w-80 bg-white shadow-xl transform -translate-x-full transition-transform duration-300 overflow-y-auto">
    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
      <a href="/" aria-label="Ir a página de inicio" title="Página principal">
        <Image 
          src={Logo_UNE} 
          alt="UNE" 
          class="h-12 w-auto" 
          width={48} 
          height={48} 
          fetchpriority="high"
          loading={"eager"}
          decoding="sync" 
        />
      </a>
      <button class="close-menu-button p-2 rounded-md text-blue-900 hover:bg-gray-100">
        <X size={24} />
      </button>
    </div>

    <div class="bg-rojo-une p-4 flex justify-center gap-4 border-b border-gray-200">
      {topBarLinks.map(link => (
        <a 
          href={link.href} 
          rel="noopener noreferrer"
          class="flex items-center"
        >
          <Image 
            src={link.img} 
            alt={link.alt} 
            class="h-10 w-auto" 
            width={40} 
            height={40} 
            loading="lazy"
          />
        </a>
      ))}
    </div>

    <nav class="p-4">
      {navItems.map(item => (
        <div class="mb-2">
          <button class="menu-section-button w-full flex items-center justify-between p-3 text-left font-semibold text-gray-900 hover:bg-gray-50 rounded-lg">
            <span>{item.label}</span>
            <ChevronDown size={16} class="chevron transition-transform duration-200" />
          </button>
          
          <div class="hidden ml-4 mt-2">
            {item.customContent ? (
              <div class="space-y-2">
                <div class="mb-3">
                  <p class="text-xs font-bold text-azul-une mb-2">Colegio UNE</p>
                  {ofertaAcademica.colegioUNE.map(link => (
                    <a href={link.href} class="block p-2 text-sm text-gray-700 hover:bg-blue-50 rounded">{link.title}</a>
                  ))}
                </div>
                <div class="mb-3">
                  <p class="text-xs font-bold text-azul-une mb-2">Medio Superior</p>
                  {ofertaAcademica.medioSuperior.map(link => (
                    <a href={link.href} class="block p-2 text-sm text-gray-700 hover:bg-blue-50 rounded">{link.title}</a>
                  ))}
                </div>
                <div class="mb-3">
                  <p class="text-xs font-bold text-azul-une mb-2">Educación Superior</p>
                  {ofertaAcademica.educacionSuperior.map(link => (
                    <a href={link.href} class="block p-2 text-sm text-gray-700 hover:bg-blue-50 rounded">{link.title}</a>
                  ))}
                </div>
                <div>
                  <p class="text-xs font-bold text-azul-une mb-2">Educación Continua</p>
                  {ofertaAcademica.educacionContinua.map(link => (
                    <a href={link.href} class="block p-2 text-sm text-gray-700 hover:bg-blue-50 rounded">{link.title}</a>
                  ))}
                </div>
              </div>
            ) : (
              <div class="space-y-1">
                {item.links?.map(link => (
                  link.featured ? (
                    <a href={link.href} class="openhouse-mobile-link block p-3 text-sm font-bold text-white rounded-lg relative overflow-hidden" style="background: linear-gradient(135deg, #1a237e 0%, #1565c0 50%, #0288d1 100%);">
                      <span class="badge-nuevo-mobile">¡Evento!</span>
                      {link.title}
                    </a>
                  ) : (
                    <a href={link.href} class="block p-2 text-sm text-gray-700 hover:bg-blue-50 rounded">{link.title}</a>
                  )
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </nav>
  </div>
</div>

<script>
  // Mobile menu functionality
  const mobileMenuButton = document.querySelector(".mobile-menu-button");
  const mobileMenu = document.querySelector(".mobile-menu");
  const menuContainer = document.querySelector(".mobile-menu-container");
  const closeMenuButton = document.querySelector(".close-menu-button");

  function toggleMenu(open) {
    if (open) {
      mobileMenu?.classList.remove("opacity-0", "invisible");
      mobileMenu?.classList.add("opacity-100", "visible");
      menuContainer?.classList.remove("-translate-x-full");
      document.body.style.overflow = "hidden";
    } else {
      menuContainer?.classList.add("-translate-x-full");
      setTimeout(() => {
        mobileMenu?.classList.remove("opacity-100", "visible");
        mobileMenu?.classList.add("opacity-0", "invisible");
        document.body.style.overflow = "";
      }, 300);
    }
  }

  mobileMenuButton?.addEventListener("click", () => toggleMenu(true));
  closeMenuButton?.addEventListener("click", () => toggleMenu(false));

  // Desktop dropdown functionality with click-to-pin
  const navItems = document.querySelectorAll("nav .group");
  const dropdowns = document.querySelectorAll(".dropdown-menu");
  const dropdownMap = ["admisiones-dropdown", "oferta-dropdown", "informacion-dropdown", "vida-dropdown", "nosotros-dropdown"];
  
  // Estado para trackear dropdowns abiertos por click
  let pinnedDropdown = null;
  let hoverTimeout = null;

  function showDropdown(dropdown, trigger) {
    clearTimeout(hoverTimeout);
    
    // Cerrar todos los otros dropdowns
    dropdowns.forEach(d => {
      if (d !== dropdown) {
        d.classList.remove("opacity-100", "visible", "translate-y-0");
        d.classList.add("opacity-0", "invisible", "translate-y-2");
      }
    });

    // Mostrar el dropdown actual
    dropdown.classList.remove("opacity-0", "invisible", "translate-y-2");
    dropdown.classList.add("opacity-100", "visible", "translate-y-0");
    
    // Rotar el chevron
    const chevron = trigger.querySelector(".chevron-icon");
    if (chevron) {
      chevron.style.transform = "rotate(180deg)";
    }
  }

  function hideDropdown(dropdown, trigger, force = false) {
    // Si el dropdown está pinned (abierto por click) y no es forzado, no cerrar
    if (pinnedDropdown === dropdown && !force) {
      return;
    }

    hoverTimeout = setTimeout(() => {
      // Verificar nuevamente si no está pinned
      if (pinnedDropdown === dropdown && !force) {
        return;
      }
      
      dropdown.classList.remove("opacity-100", "visible", "translate-y-0");
      dropdown.classList.add("opacity-0", "invisible", "translate-y-2");
      
      // Restaurar el chevron
      const chevron = trigger.querySelector(".chevron-icon");
      if (chevron) {
        chevron.style.transform = "rotate(0deg)";
      }
    }, 100);
  }

  function unpinDropdown(dropdown, trigger) {
    if (pinnedDropdown === dropdown) {
      pinnedDropdown = null;
      hideDropdown(dropdown, trigger, false);
    }
  }

  navItems.forEach((item, index) => {
    const dropdown = document.querySelector(`.${dropdownMap[index]}`);
    const trigger = item.querySelector(".dropdown-trigger");
    
    if (!dropdown || !trigger) return;

    // Hover events
    item.addEventListener("mouseenter", () => {
      showDropdown(dropdown, trigger);
    });

    item.addEventListener("mouseleave", () => {
      hideDropdown(dropdown, trigger);
    });

    dropdown.addEventListener("mouseenter", () => {
      clearTimeout(hoverTimeout);
    });

    dropdown.addEventListener("mouseleave", () => {
      hideDropdown(dropdown, trigger);
    });

    // Click event para pin/unpin
    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      if (pinnedDropdown === dropdown) {
        unpinDropdown(dropdown, trigger);
      } else {
        pinnedDropdown = dropdown;
        showDropdown(dropdown, trigger);
      }
    });
  });

  // Cerrar dropdown pinned al hacer click fuera
  document.addEventListener("click", (e) => {
    if (pinnedDropdown) {
      const isInsideDropdown = pinnedDropdown.contains(e.target);
      const isInsideTrigger = Array.from(navItems).some(item => 
        item.contains(e.target)
      );
      
      if (!isInsideDropdown && !isInsideTrigger) {
        const index = Array.from(dropdowns).indexOf(pinnedDropdown);
        const trigger = document.querySelector(`nav .group[data-dropdown-index="${index}"] .dropdown-trigger`);
        unpinDropdown(pinnedDropdown, trigger);
      }
    }
  });

  // Mobile submenu functionality
  document.querySelectorAll(".menu-section-button").forEach(section => {
    section.addEventListener("click", () => {
      const submenu = section.nextElementSibling;
      const chevron = section.querySelector(".chevron");
      submenu?.classList.toggle("hidden");
      chevron?.classList.toggle("rotate-180");
    });
  });

  // Close menu on escape key
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") {
      toggleMenu(false);
      
      if (pinnedDropdown) {
        const index = Array.from(dropdowns).indexOf(pinnedDropdown);
        const trigger = document.querySelector(`nav .group[data-dropdown-index="${index}"] .dropdown-trigger`);
        unpinDropdown(pinnedDropdown, trigger);
      }
      
      dropdowns.forEach(dropdown => {
        dropdown.classList.remove("opacity-100", "visible", "translate-y-0");
        dropdown.classList.add("opacity-0", "invisible", "translate-y-2");
      });
    }
  });
</script>

<style>
  /* ===== Open House Featured Link ===== */
  .openhouse-featured-link {
    box-shadow: 0 4px 15px rgba(21, 101, 192, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .openhouse-featured-link:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 25px rgba(21, 101, 192, 0.55);
  }

  /* Shimmer sweep animation */
  .openhouse-shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.25) 50%,
      transparent 60%
    );
    background-size: 200% 100%;
    animation: shimmer 2.4s infinite;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes shimmer {
    0%   { background-position: -200% 0; }
    100% { background-position:  200% 0; }
  }

  /* Badge "¡Evento!" – desktop */
  .badge-nuevo {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #fff;
    color: #1565c0;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 999px;
    z-index: 10;
    animation: pulse-badge 1.8s ease-in-out infinite;
  }
  @keyframes pulse-badge {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%       { opacity: 0.8; transform: scale(1.08); }
  }

  /* Mobile featured link */
  .openhouse-mobile-link {
    box-shadow: 0 3px 10px rgba(21, 101, 192, 0.35);
    transition: opacity 0.2s ease;
  }
  .openhouse-mobile-link:hover {
    opacity: 0.9;
  }

  /* Badge mobile */
  .badge-nuevo-mobile {
    display: inline-block;
    background: #fff;
    color: #1565c0;
